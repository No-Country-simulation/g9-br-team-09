# Selecione uma imagem linux/amd64 identificada por tag imutavel.
# Exemplo de formato: energiai-backend:issue-107-<commit-curto>
# Alternativa publicada: pxs00/energiai-backend:sha-<commit-curto>
BACKEND_IMAGE=

# Deixe vazio na OCI para usar /opt/energiai/config/backend.env.
# Informe um caminho absoluto apenas em validacoes locais controladas.
BACKEND_ENV_FILE=

SPRING_PROFILES_ACTIVE=oci

# Limite inicial conservador para uma VM com 1 GB; confirme o comportamento na OCI.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=55.0 -XX:InitialRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError

# JDBC Thin TLS sem wallet. Formato esperado: jdbc:oracle:thin:@tcps://<host>:<porta>/<service-name>
# Nao inclua aqui URL, host, service name, usuario ou senha reais.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_CONNECT_RETRIES=5
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_KEEPALIVE_TIME_MS=120000

# O loopback do proprio container, em uma porta sem servico, valida intencionalmente o fallback.
# Substitua somente quando houver uma FastAPI autorizada e acessivel pela rede do container.
ML_API_BASE_URL=http://127.0.0.1:9
ML_API_CONNECT_TIMEOUT=2s
ML_API_READ_TIMEOUT=5s

# Separe multiplas origens exatas por virgula. Nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
